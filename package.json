{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "node --test resources/js/pos/*.test.js",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test --reporter=line",
        "build": "npm run build:app && npm run build:filament",
        "build:app": "vite build",
        "build:filament": "node scripts/build-filament-theme.mjs",
        "dev": "npm run build:filament && vite"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "tailwindcss3": "npm:tailwindcss@^3.4.19",
        "vite": "^8.0.0"
    }
}
